# ---- Rime (Voice Models Partner) — get key from rime.ai dashboard ----
RIME_API_KEY=
RIME_MODEL=mistv2            # verify against docs.rime.ai/docs/models (Coda / Mist v3)
RIME_SPEAKER_HI=rainforest   # pick Hindi-capable voice from docs.rime.ai/docs/voices
RIME_SPEAKER_EN=cove

# ---- Qdrant (Vector Search Partner) — local docker OR free Qdrant Cloud cluster ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- LLM (Hugging Face router by default — free tier, OpenAI-compatible) ----
LLM_PROVIDER=huggingface     # huggingface | anthropic | openai
HF_TOKEN=                    # hf.co/settings/tokens -> fine-grained -> "Make calls to Inference Providers"
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct    # cheap + good Hindi — stretches free credits; try 72B if credits allow
LLM_BASE_URL=https://router.huggingface.co/v1
ANTHROPIC_API_KEY=           # optional alternatives
OPENAI_API_KEY=

# ---- App ----
MOCK_MODE=0                  # 1 = demo UI without any keys (dev only; judged demo must be 0)
CAREGIVER_WEBHOOK_URL=       # optional: real webhook (e.g. webhook.site) for escalation demo
